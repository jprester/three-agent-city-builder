# Generated binaries are committed as regular git files (no LFS; see docs/DECISIONS.md).
# Mark them binary so git never tries to diff or merge them as text.
*.glb    binary
*.bin    binary
*.png    binary
*.jpg    binary
*.jpeg   binary
*.webp   binary
*.ktx2   binary
*.ttf    binary
*.otf    binary
*.woff   binary
*.woff2  binary
