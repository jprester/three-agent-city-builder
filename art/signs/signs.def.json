{
  "$comment": "The city's sign and ad library (docs/ADS-PLAN.md). Every sign belongs to a business (a tenant at a fixed floor) or a brand. tools/textures/build_signs.py renders each sign with Z-Image Turbo from one style template (`styles`), crops it to the sign, and packs the atlases in art/textures/signs/ with catalog.json. Seeds: `seed` + the sign's index unless `seeds` pins a pick (re-rolled because a take garbled its text). Rejected takes and why: `rejects`.",
  "seed": 4000,
  "background": "isolated on a plain pure black background, centered, the entire sign visible with black margin on all sides, straight-on front view, flat orthographic, photographed at night, no building, no street, no people, no other text",
  "styles": {
    "lightbox": "A single {shape} Japanese {trade} sign: a backlit acrylic lightbox glowing at night, {face} face with bold {ink} Japanese lettering (Japanese kanji and kana, not simplified Chinese) reading {text}{extra}, thin dark metal frame",
    "neon": "A single {shape} Hong Kong {trade} neon sign: exposed glowing glass neon tubes forming the traditional Chinese characters {text} in {ink}{extra}, with a neon tube border in {border}, tubes mounted on a dark steel frame",
    "billboard": "A single large Japanese {trade} advertising billboard: a backlit lightbox, the left half a bright photo of {photo}, the right half {face} with bold {ink} Japanese lettering reading {text} and below it a large floor number {floor}, thin dark metal frame",
    "brand": "{art}, full-bleed advertising photograph filling the entire frame edge to edge, rich saturated colour, dramatic light, no text, no logo, no letters, no frame, no billboard, no border"
  },
  "formats": {
    "fascia": {
      "style": "lightbox",
      "shape": "wide horizontal shop fascia",
      "size": [
        1536,
        512
      ]
    },
    "blade": {
      "style": "lightbox",
      "shape": "tall narrow vertical projecting",
      "size": [
        512,
        1536
      ],
      "vertical": true
    },
    "panel": {
      "style": "lightbox",
      "shape": "square tenant",
      "size": [
        1024,
        1024
      ]
    },
    "billboard": {
      "style": "billboard",
      "size": [
        1536,
        768
      ]
    },
    "overhang": {
      "style": "neon",
      "shape": "large horizontal",
      "size": [
        1344,
        768
      ]
    },
    "hkblade": {
      "style": "neon",
      "shape": "tall narrow vertical",
      "size": [
        512,
        1536
      ],
      "vertical": true
    },
    "land": {
      "style": "brand",
      "size": [
        1536,
        640
      ]
    },
    "tall": {
      "style": "brand",
      "size": [
        512,
        1536
      ]
    }
  },
